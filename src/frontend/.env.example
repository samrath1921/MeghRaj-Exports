# Copy to src/frontend/.env.local for local development, and set the same keys in
# the Vercel project (Settings -> Environment Variables) for deployments.
# Never commit a filled-in copy of this file.

# ── Analytics (build-time; compiled into the client bundle) ──────────────────
# Must be set in Vercel too, not only locally — otherwise the deployed build ships
# the literal placeholder and Google Analytics receives nothing. Vercel does NOT
# rebuild when an environment variable changes; trigger a new build after editing.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: overrides the WhatsApp link used by the floating button and contact page.
VITE_WHATSAPP_URL=https://wa.me/919696697000

# ── SMTP for the enquiry form (server-side only) ────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# ── Durable enquiry storage (optional; strongly recommended) ────────────────
# Without these the contact API still works, but an enquiry exists only as an
# email — so a failed send loses it permanently.
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Server-side only.
# Never give it a VITE_ prefix: anything VITE_-prefixed is compiled into the
# browser bundle and becomes public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Instant enquiry notification (optional) ─────────────────────────────────
# Pushes each new enquiry to a phone within seconds. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
