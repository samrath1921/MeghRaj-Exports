EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=info@meghrajexports.com
EMAIL_PASS=your_smtp_password

# GA4 Measurement ID (format: G-XXXXXXXXXX). Leave unset to disable analytics entirely —
# no gtag.js request is made and no events fire when this is empty. Must be prefixed with
# VITE_ so Vite exposes it to client code and inlines it into index.html at build time.
VITE_GA_MEASUREMENT_ID=
